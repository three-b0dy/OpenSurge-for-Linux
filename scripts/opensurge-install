#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly PRODUCTION_ETC_DIR=/etc
readonly PRODUCTION_STATE_DIR=/var/lib/opensurge
readonly PRODUCTION_LOG=/var/log/opensurge-install.log
readonly PRODUCTION_BIN_DIR=/usr/sbin
readonly PRODUCTION_RUN_DIR=/run
readonly RELEASE_REPOSITORY_URL=https://github.com/three-b0dy/OpenSurge-for-Linux

etc_dir=$PRODUCTION_ETC_DIR
state_dir=$PRODUCTION_STATE_DIR
installer_log=$PRODUCTION_LOG
bin_dir=$PRODUCTION_BIN_DIR
run_dir=$PRODUCTION_RUN_DIR
installer_root=/
tty_path=/dev/tty
release_repository_url=$RELEASE_REPOSITORY_URL
allow_insecure_test_release=0
download_dir=''
temporary_policy_path=''
temporary_policy_identity=''
temporary_policy_contents=''
temporary_policy_marker=''
temporary_config_path=''
installer_marker_dir=''
installer_marker_path=''
installer_marker_identity=''
installer_marker_contents=''
install_state_dir=''
install_manifest_path=''
resolv_conf_backup_path=''
installer_transaction_id=''
host_state_transaction_started=0
selected_resolver=none
resolver_selection=none
resolver_was_altered=0
resolved_was_altered=0
resolved_was_enabled=0
resolved_was_active=0
dnsmasq_was_altered=0
dnsmasq_was_enabled=0
dnsmasq_was_active=0
resolv_conf_backup_exists=0
resolv_conf_kind=absent
control_status_url=''

cleanup() {
	local status=$?

	trap - EXIT
	if test -n "$installer_marker_path"; then
		restore_installer_marker
	fi
	if test "$status" -ne 0 && test "$host_state_transaction_started" -eq 1; then
		if ! rollback_host_state; then
			log 'host-state rollback did not complete; preserving install-state recovery records'
		fi
	fi
	if test -n "$temporary_policy_path" && temporary_policy_is_ours; then
		rm -f -- "$temporary_policy_path"
	fi
	if test -n "$download_dir"; then
		rm -rf -- "$download_dir"
	fi
	if test -n "$temporary_config_path"; then
		rm -f -- "$temporary_config_path"
	fi
	exit "$status"
}

die() {
	printf 'opensurge-install: %s\n' "$*" >&2
	exit 2
}

log() {
	local message=$1
	local timestamp

	if test -n "${OPENSURGE_TEST_SECRET:-}"; then
		message=${message//"$OPENSURGE_TEST_SECRET"/[REDACTED]}
	fi
	timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
	printf '%s %s\n' "$timestamp" "$message" >>"$installer_log"
}

has_test_override() {
	test -n "${OPENSURGE_INSTALLER_ROOT+x}" || \
		test -n "${OPENSURGE_INSTALLER_BIN_DIR+x}" || \
		test -n "${OPENSURGE_INSTALLER_LOG+x}" || \
		test -n "${OPENSURGE_INSTALLER_TTY+x}" || \
		test -n "${OPENSURGE_INSTALLER_TEST_RELEASE_BASE_URL+x}" || \
		test -n "${OPENSURGE_INSTALLER_TEST_TRANSFER_PREREQUISITES+x}"
}

configure_paths() {
	if test "${OPENSURGE_INSTALLER_TEST:-}" != 1; then
		has_test_override && die 'test path overrides require OPENSURGE_INSTALLER_TEST=1'
		return
	fi

	installer_root=${OPENSURGE_INSTALLER_ROOT:?OPENSURGE_INSTALLER_ROOT is required in test mode}
	bin_dir=${OPENSURGE_INSTALLER_BIN_DIR:?OPENSURGE_INSTALLER_BIN_DIR is required in test mode}
	installer_log=${OPENSURGE_INSTALLER_LOG:?OPENSURGE_INSTALLER_LOG is required in test mode}
	tty_path=${OPENSURGE_INSTALLER_TTY:?OPENSURGE_INSTALLER_TTY is required in test mode}

	case "$installer_root:$bin_dir:$installer_log:$tty_path" in
		/*:/*:/*:/*) ;;
		*) die 'test paths must be absolute' ;;
	esac
	if test "$installer_root" = /; then
		etc_dir=$PRODUCTION_ETC_DIR
		state_dir=$PRODUCTION_STATE_DIR
		run_dir=$PRODUCTION_RUN_DIR
	else
		etc_dir="$installer_root$PRODUCTION_ETC_DIR"
		state_dir="$installer_root$PRODUCTION_STATE_DIR"
		run_dir="$installer_root$PRODUCTION_RUN_DIR"
	fi

	if test -n "${OPENSURGE_INSTALLER_TEST_RELEASE_BASE_URL:-}"; then
		release_repository_url=${OPENSURGE_INSTALLER_TEST_RELEASE_BASE_URL%/}
		case "$release_repository_url" in
			http://*|https://*|file://*) allow_insecure_test_release=1 ;;
			*) die 'invalid test release URL' ;;
		esac
	fi
}

require_option_value() {
	local option=$1
	local value=${2:-}
	test -n "$value" && [[ $value != --* ]] || die "$option requires a value"
	printf '%s' "$value"
}

is_ipv4() {
	local address=$1
	local octet
	local -a octets

	IFS=. read -r -a octets <<<"$address"
	test "${#octets[@]}" -eq 4 || return 1
	for octet in "${octets[@]}"; do
		[[ $octet =~ ^[0-9]{1,3}$ ]] || return 1
		((10#$octet <= 255)) || return 1
	done
}

is_unicast_ipv4() {
	local address=$1
	local -a octets

	is_ipv4 "$address" || return 1
	IFS=. read -r -a octets <<<"$address"
	((10#${octets[0]} > 0 && 10#${octets[0]} < 224 && 10#${octets[0]} != 127)) || return 1
	test "$address" != 255.255.255.255
}

ipv6_group_count() {
	local value=$1
	local part
	local count=0
	local -a parts

	test -n "$value" || {
		printf '0'
		return
	}
	IFS=: read -r -a parts <<<"$value"
	for part in "${parts[@]}"; do
		[[ $part =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
		count=$((count + 1))
	done
	printf '%s' "$count"
}

is_nonlocal_ipv6() {
	local address=$1
	local left
	local right
	local left_count
	local right_count
	local group_count
	local compact=0
	local flattened

	[[ $address == *:* ]] || return 1
	[[ $address != *[!0-9A-Fa-f:]* ]] || return 1
	[[ $address != *::*::* ]] || return 1
	if [[ $address == *::* ]]; then
		compact=1
		left=${address%%::*}
		right=${address#*::}
		[[ $left != *: && $right != :* ]] || return 1
		left_count=$(ipv6_group_count "$left") || return 1
		right_count=$(ipv6_group_count "$right") || return 1
		group_count=$((left_count + right_count))
		test "$group_count" -lt 8 || return 1
	else
		[[ $address != :* && $address != *: ]] || return 1
		group_count=$(ipv6_group_count "$address") || return 1
		test "$group_count" -eq 8 || return 1
	fi

	flattened=${address//:/}
	[[ ! $flattened =~ ^0+$ ]] || return 1
	if test "$compact" -eq 1 && test -z "$left" && [[ $right =~ ^0*1$ ]]; then
		return 1
	fi
	if test "$compact" -eq 0 && [[ $flattened =~ ^0*1$ ]]; then
		return 1
	fi
	[[ $address != [Ff][Ff]* && $address != [Ff][Ee][89AaBb][0-9A-Fa-f]:* ]]
}

is_ipv4_cidr() {
	local value=$1
	local address prefix

	IFS=/ read -r address prefix <<<"$value"
	test -n "$address" && test -n "$prefix" || return 1
	[[ $prefix =~ ^[0-9]{1,2}$ ]] || return 1
	((10#$prefix <= 32)) || return 1
	is_unicast_ipv4 "$address"
}

is_interface_name() {
	[[ $1 =~ ^[[:alnum:]][[:alnum:]_.:-]{0,14}$ ]]
}

validate_isolated_arguments() {
	test -n "$downstream_interface" && test -n "$upstream_interface" && \
		test -n "$lan_ip" && test -n "$lan_cidr" || \
		die 'isolated_lan requires --downstream-interface, --upstream-interface, --lan-ip, and --lan-cidr'
	is_interface_name "$downstream_interface" || die 'invalid downstream interface'
	is_interface_name "$upstream_interface" || die 'invalid upstream interface'
	is_unicast_ipv4 "$lan_ip" || die 'invalid LAN IPv4 address'
	is_ipv4_cidr "$lan_cidr" || die 'invalid LAN CIDR'
	if test -n "$dhcp_range_start" || test -n "$dhcp_range_end"; then
		test -n "$dhcp_range_start" && test -n "$dhcp_range_end" || \
			die 'DHCP range requires both --dhcp-range-start and --dhcp-range-end'
		is_unicast_ipv4 "$dhcp_range_start" || die 'invalid DHCP range start'
		is_unicast_ipv4 "$dhcp_range_end" || die 'invalid DHCP range end'
	fi
}

route_field() {
	local route_output=$1
	local wanted_field=$2
	local -a fields
	local index

	read -r -a fields <<<"$route_output"
	for ((index = 0; index + 1 < ${#fields[@]}; index++)); do
		if test "${fields[$index]}" = "$wanted_field"; then
			printf '%s' "${fields[$((index + 1))]}"
			return 0
		fi
	done
	return 1
}

validate_interface_exists() {
	local interface_name=$1

	is_interface_name "$interface_name" || die "invalid interface: $interface_name"
	ip link show dev -- "$interface_name" >/dev/null 2>&1 || die "Linux interface does not exist: $interface_name"
}

ipv4_to_u32() {
	local address=$1
	local -a octets

	IFS=. read -r -a octets <<<"$address"
	printf '%u' "$(((10#${octets[0]} << 24) | (10#${octets[1]} << 16) | (10#${octets[2]} << 8) | 10#${octets[3]}))"
}

cidr_prefix() {
	local cidr=$1
	printf '%s' "${cidr#*/}"
}

cidr_address() {
	local cidr=$1
	printf '%s' "${cidr%/*}"
}

cidr_mask() {
	local prefix=$1

	if test "$prefix" -eq 0; then
		printf '0'
		return
	fi
	printf '%u' "$(((0xffffffff << (32 - prefix)) & 0xffffffff))"
}

ipv4_in_cidr() {
	local address=$1
	local cidr=$2
	local prefix
	local mask
	local address_number
	local network_number

	prefix=$(cidr_prefix "$cidr")
	mask=$(cidr_mask "$prefix")
	address_number=$(ipv4_to_u32 "$address")
	network_number=$(ipv4_to_u32 "$(cidr_address "$cidr")")
	test "$((address_number & mask))" -eq "$((network_number & mask))"
}

ipv4_is_network_or_broadcast() {
	local address=$1
	local cidr=$2
	local prefix
	local mask
	local address_number
	local network_number
	local broadcast_number

	prefix=$(cidr_prefix "$cidr")
	test "$prefix" -le 30 || return 1
	mask=$(cidr_mask "$prefix")
	address_number=$(ipv4_to_u32 "$address")
	network_number=$(( $(ipv4_to_u32 "$(cidr_address "$cidr")") & mask ))
	broadcast_number=$((network_number | ((~mask) & 0xffffffff)))
	test "$address_number" -eq "$network_number" || test "$address_number" -eq "$broadcast_number"
}

ipv4_prefix_24() {
	local address=$1
	local -a octets

	IFS=. read -r -a octets <<<"$address"
	printf '%s.%s.%s' "${octets[0]}" "${octets[1]}" "${octets[2]}"
}

is_nonlocal_nameserver() {
	local address=$1

	if is_unicast_ipv4 "$address"; then
		return 0
	fi
	is_nonlocal_ipv6 "$address"
}

has_nonlocal_resolver() {
	local resolver_path="$etc_dir/resolv.conf"
	local record_type
	local address
	local ignored

	test -r "$resolver_path" || return 1
	while read -r record_type address ignored; do
		if test "$record_type" = nameserver && is_nonlocal_nameserver "$address"; then
			return 0
		fi
	done <"$resolver_path"
	return 1
}

interface_has_ipv4() {
	local interface_name=$1
	local expected_address=$2
	local record_type
	local address_with_prefix
	local ignored

	while read -r record_type address_with_prefix ignored; do
		if test "$record_type" = inet && test "${address_with_prefix%/*}" = "$expected_address"; then
			return 0
		fi
	done < <(ip -4 addr show dev -- "$interface_name")
	return 1
}

validate_dhcp_range() {
	local cidr=$1
	local start=$2
	local end=$3
	local start_number
	local end_number
	local lan_number

	is_unicast_ipv4 "$start" || die 'invalid DHCP range start'
	is_unicast_ipv4 "$end" || die 'invalid DHCP range end'
	ipv4_in_cidr "$start" "$cidr" && ipv4_in_cidr "$end" "$cidr" || die 'DHCP range must remain inside LAN CIDR'
	ipv4_is_network_or_broadcast "$start" "$cidr" && die 'DHCP range must not include the network or broadcast address'
	ipv4_is_network_or_broadcast "$end" "$cidr" && die 'DHCP range must not include the network or broadcast address'
	start_number=$(ipv4_to_u32 "$start")
	end_number=$(ipv4_to_u32 "$end")
	lan_number=$(ipv4_to_u32 "$lan_ip")
	test "$start_number" -le "$end_number" || die 'DHCP range start must not be after DHCP range end'
	test "$lan_number" -lt "$start_number" || test "$lan_number" -gt "$end_number" || die 'DHCP range must not include LAN IPv4'
}

collect_default_route_topology() {
	local route_get_output
	local default_route_output
	local default_route_device
	local default_route_source
	local default_route_gateway
	local default_route_table_device

	route_get_output=$(ip -4 route get 1.1.1.1) || die 'cannot inspect IPv4 default route'
	default_route_output=$(ip -4 route show default) || die 'cannot inspect IPv4 default route'
	default_route_device=$(route_field "$route_get_output" dev || true)
	default_route_source=$(route_field "$route_get_output" src || true)
	default_route_gateway=$(route_field "$route_get_output" via || true)
	default_route_table_device=$(route_field "$default_route_output" dev || true)

	test -n "$default_route_device" && test -n "$default_route_table_device" || die 'default-route interface is required'
	test "$default_route_device" = "$default_route_table_device" || die 'default-route interface does not match route table'
	test -n "$default_route_source" || die 'default-route source IPv4 is required'
	is_unicast_ipv4 "$default_route_source" || die 'default-route source IPv4 is invalid'
	if test -n "$default_route_gateway"; then
		is_unicast_ipv4 "$default_route_gateway" || die 'default-route gateway IPv4 is invalid'
	else
		default_route_gateway=$(route_field "$default_route_output" via || true)
		if test -n "$default_route_gateway"; then
			is_unicast_ipv4 "$default_route_gateway" || die 'default-route gateway IPv4 is invalid'
		fi
	fi
	test -n "$default_route_gateway" || has_nonlocal_resolver || die 'no default-route gateway or non-local resolver is available'
	validate_interface_exists "$default_route_device"

	downstream_interface=$default_route_device
	upstream_interface=$default_route_device
	lan_ip=$default_route_source
	lan_cidr=''
	dhcp_range_start="$(ipv4_prefix_24 "$lan_ip").100"
	dhcp_range_end="$(ipv4_prefix_24 "$lan_ip").200"
}

collect_isolated_topology() {
	local prefix
	local lan_prefix

	validate_interface_exists "$downstream_interface"
	validate_interface_exists "$upstream_interface"
	test "$downstream_interface" != "$upstream_interface" || die 'isolated_lan requires distinct downstream and upstream interfaces'
	interface_has_ipv4 "$downstream_interface" "$lan_ip" || die 'LAN IPv4 is not configured on downstream interface'
	ipv4_in_cidr "$lan_ip" "$lan_cidr" || die 'LAN IPv4 must fall inside LAN CIDR'
	ipv4_is_network_or_broadcast "$lan_ip" "$lan_cidr" && die 'LAN IPv4 must not be the network or broadcast address'
	prefix=$(cidr_prefix "$lan_cidr")
	if test "$prefix" -eq 24; then
		lan_prefix=$(ipv4_prefix_24 "$lan_ip")
		if test -z "$dhcp_range_start"; then
			dhcp_range_start="$lan_prefix.100"
			dhcp_range_end="$lan_prefix.200"
		fi
	else
		test -n "$dhcp_range_start" && test -n "$dhcp_range_end" || die 'non-/24 isolated LAN requires an explicit DHCP range'
	fi
	validate_dhcp_range "$lan_cidr" "$dhcp_range_start" "$dhcp_range_end"
}

collect_fresh_topology() {
	case "$mode" in
		same_lan) collect_default_route_topology ;;
		isolated_lan) collect_isolated_topology ;;
		*) die "fresh configuration is not supported for mode: $mode" ;;
	esac
}

render_fresh_config() {
	local config_directory="$etc_dir/opensurge"
	local config_path="$config_directory/config.yaml"
	local dhcp_enabled=false
	local rendered_mode=$mode

	if test "$mode" = isolated_lan; then
		dhcp_enabled=true
	fi
	mkdir -p "$config_directory" || die 'cannot create OpenSurge configuration directory'
	temporary_config_path=$(mktemp "$config_directory/.config.yaml.XXXXXX") || die 'cannot create temporary OpenSurge configuration'
	chmod 0600 "$temporary_config_path" || die 'cannot protect temporary OpenSurge configuration'
	cat >"$temporary_config_path" <<EOF
gateway:
  mode: "$rendered_mode"
  interface: "$downstream_interface"
  lan_ip: "$lan_ip"
  upstream_interface: "$upstream_interface"
  router_dhcp_disabled_confirmed: false

dhcp:
  binary: "dnsmasq"
  enabled: $dhcp_enabled
  range_start: "$dhcp_range_start"
  range_end: "$dhcp_range_end"
  lease_time: "12h"
  domain: "lan"

device_policy:
  file: ""
  protected_ipv4: ""

dns:
  listen: "$lan_ip"
  port: 53
  upstream: "127.0.0.1#1053"

management:
  listen: "$lan_ip:61767"
  tls_cert_file: ""
  tls_key_file: ""

mihomo:
  binary: "/usr/lib/opensurge/mihomo"
  config: "/run/opensurge/mihomo.yaml"
  profile_mode: "managed"
  profile: ""
  mixed_port: 7890
  redir_port: 0
  api_addr: "127.0.0.1:9090"
  secret: ""

nftables:
  table: "opensurge"

transparent:
  mode: "off"
  tun_device: "opensurge-tun"
  tun_stack: "mixed"
  tun_auto_route: true
  tun_auto_redirect: true
  tun_auto_detect_interface: false
  tun_strict_route: false

upstream_proxy:
  enabled: false
  name: "real-device-egress"
  type: "http"
  server: "127.0.0.1"
  port: 18080
  username: ""
  password: ""
  match_domain: "example.com"

runtime:
  dir: "/var/lib/opensurge/runtime"
EOF
	mv -f -- "$temporary_config_path" "$config_path" || die 'cannot install OpenSurge configuration'
	temporary_config_path=''
	chown root:opensurge "$config_path" || die 'cannot set OpenSurge configuration ownership'
	chmod 0640 "$config_path" || die 'cannot set OpenSurge configuration mode'
	opensurge config validate --config "$config_path" || die 'generated OpenSurge configuration did not validate'
	log "generated fresh $mode configuration at $config_path"
}

administrator_state_path() {
	printf '%s' "$state_dir/admin.json"
}

administrator_is_initialized() {
	local admin_path

	admin_path=$(administrator_state_path)
	test -e "$admin_path" || test -L "$admin_path"
}

generate_installer_password() {
	local password

	if test "${OPENSURGE_INSTALLER_TEST:-}" = 1 && test -n "${OPENSURGE_INSTALLER_TEST_ADMIN_PASSWORD:-}"; then
		password=$OPENSURGE_INSTALLER_TEST_ADMIN_PASSWORD
	else
		password=$(LC_ALL=C od -An -N 32 -tx1 /dev/urandom | tr -d ' \n') || \
			die 'cannot generate the administrator password'
	fi
	[[ $password =~ ^[A-Za-z0-9_-]+$ ]] && test "${#password}" -ge 12 && test "${#password}" -le 256 || \
		die 'cannot generate a URL-safe administrator password'
	printf '%s' "$password"
}

initialize_administrator() {
	local admin_password
	local setup_status
	local setup_binary="$installer_root/usr/bin/opensurge-setup"

	if administrator_is_initialized; then
		log 'preserved existing OpenSurge administrator state'
		return
	fi
	if test -e /dev/fd/9; then
		die 'cannot reserve installer password pipe descriptor'
	fi

	admin_password=$(generate_installer_password)
	# The deterministic test-only source must not be inherited by setup either.
	unset OPENSURGE_INSTALLER_TEST_ADMIN_PASSWORD
	printf '%s\n' 'OpenSurge created the local admin account. Change this one-time password immediately in the Web UI:' >>"$tty_path"
	printf '%s\n' "$admin_password" >>"$tty_path"
	exec 9< <(printf '%s\n' "$admin_password")
	test -x "$setup_binary" || die 'installed OpenSurge setup binary is unavailable'
	if "$setup_binary" init --username admin --password-fd 9; then
		setup_status=0
	else
		setup_status=$?
	fi
	unset admin_password
	exec 9<&-
	test "$setup_status" -eq 0 || die 'cannot initialize the OpenSurge administrator account'
	administrator_is_initialized || die 'OpenSurge administrator initialization did not create state'
	log 'initialized the OpenSurge administrator account'
}

management_status_url() {
	local config_path="$etc_dir/opensurge/config.yaml"
	local listener
	local host
	local port

	listener=$(awk '
		/^[[:space:]]*management:[[:space:]]*$/ { in_management = 1; next }
		in_management && /^[^[:space:]]/ { exit }
		in_management && /^[[:space:]]*listen:[[:space:]]*/ {
			value = $0
			sub(/^[[:space:]]*listen:[[:space:]]*/, "", value)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
			print value
			exit
		}
	' "$config_path") || die 'cannot read management listener from OpenSurge configuration'
	listener=${listener#\"}
	listener=${listener%\"}
	listener=${listener#\'}
	listener=${listener%\'}
	host=${listener%:*}
	port=${listener##*:}
	test -n "$listener" && test "$host" != "$listener" || die 'OpenSurge management listener is invalid'
	is_unicast_ipv4 "$host" || die 'OpenSurge management listener must use a non-local IPv4 address'
	[[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || \
		die 'OpenSurge management listener port is invalid'
	printf 'https://%s:%s/api/v1/auth/status' "$host" "$port"
}

report_control_plane_diagnostics() {
	systemctl status --no-pager opensurge-gateway.socket opensurge-control.service >&2 || true
	journalctl --no-pager --lines 50 --unit opensurge-gateway.service --unit opensurge-control.service >&2 || true
}

start_and_verify_control_plane() {
	local attempt
	local attempts=15
	local status_payload

	control_status_url=$(management_status_url)
	systemctl enable --now opensurge-gateway.socket opensurge-control.service || \
		die 'cannot enable and start OpenSurge control services'
	if test "${OPENSURGE_INSTALLER_TEST:-}" = 1; then
		attempts=1
	fi
	for ((attempt = 1; attempt <= attempts; attempt++)); do
		if status_payload=$(curl --fail --silent --show-error --insecure "$control_status_url") && \
			[[ $status_payload == *'"initialized":true'* ]]; then
			log "verified OpenSurge HTTPS control availability at $control_status_url"
			return
		fi
		if test "$attempt" -lt "$attempts"; then
			sleep 1
		fi
	done
	report_control_plane_diagnostics
	die "OpenSurge HTTPS control endpoint did not become available at $control_status_url"
}

validate_arguments() {
	case "$mode" in
		same_lan|same_wifi_dhcp) ;;
		isolated_lan) validate_isolated_arguments ;;
		*) die "unsupported mode: $mode" ;;
	esac

	if test "$mode" != isolated_lan && { test -n "$downstream_interface" || test -n "$upstream_interface" || test -n "$lan_ip" || test -n "$lan_cidr" || test -n "$dhcp_range_start" || test -n "$dhcp_range_end"; }; then
		die 'topology options require --mode isolated_lan'
	fi

	test "$package_source_count" -le 1 || die 'choose only one package source'
	if test -n "$version" && ! [[ $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$ ]]; then
		die 'invalid release tag'
	fi
	if test -n "$checksums" && test -z "$deb"; then
		die '--checksums requires --deb'
	fi
}

require_root_and_tty() {
	if test "${OPENSURGE_INSTALLER_TEST:-}" != 1; then
		test "$EUID" -eq 0 || die 'must be run as root'
	fi
	test -w "$tty_path" || die 'a writable controlling TTY is required'
}

canonical_regular_file() {
	local input=$1
	local candidate
	local directory
	local filename
	local link_target
	local hops

	directory=$(cd -P -- "$(dirname -- "$input")" && pwd) || die "cannot canonicalize file: $input"
	filename=$(basename -- "$input")
	candidate="$directory/$filename"
	for ((hops = 0; hops < 40; hops++)); do
		test -L "$candidate" || break
		link_target=$(readlink "$candidate") || die "cannot resolve symbolic link: $input"
		case "$link_target" in
			/*) candidate=$link_target ;;
			*) candidate="$(dirname -- "$candidate")/$link_target" ;;
		esac
		directory=$(cd -P -- "$(dirname -- "$candidate")" && pwd) || die "cannot canonicalize file: $input"
		filename=$(basename -- "$candidate")
		candidate="$directory/$filename"
	done
	test ! -L "$candidate" || die "too many symbolic links: $input"
	test -f "$candidate" && test -r "$candidate" || die "regular readable file is required: $input"
	printf '%s' "$candidate"
}

determine_architecture() {
	local architecture

	architecture=$(dpkg --print-architecture) || die 'cannot determine Debian architecture'
	case "$architecture" in
		amd64|arm64) printf '%s' "$architecture" ;;
		*) die "unsupported Debian architecture: $architecture" ;;
	esac
}

prepare_download_dir() {
	download_dir=$(mktemp -d "${TMPDIR:-/tmp}/opensurge-install.XXXXXX") || die 'cannot create temporary download directory'
	chmod 0700 "$download_dir" || die 'cannot protect temporary download directory'
}

transfer_prerequisites_available() {
	if test "${OPENSURGE_INSTALLER_TEST:-}" = 1 && test -n "${OPENSURGE_INSTALLER_TEST_TRANSFER_PREREQUISITES:-}"; then
		case "$OPENSURGE_INSTALLER_TEST_TRANSFER_PREREQUISITES" in
			available) return 0 ;;
			missing) return 1 ;;
			*) die 'invalid test transfer-prerequisite state' ;;
		esac
	fi

	command -v curl >/dev/null 2>&1 && test -r /etc/ssl/certs/ca-certificates.crt
}

policy_file_identity() {
	local policy_path=$1

	if stat -c '%u:%a:%d:%i' "$policy_path" 2>/dev/null; then
		return
	fi
	stat -f '%u:%Lp:%d:%i' "$policy_path" 2>/dev/null
}

temporary_policy_is_ours() {
	local current_identity
	local current_contents

	test -f "$temporary_policy_path" && ! test -L "$temporary_policy_path" || return 1
	current_identity=$(policy_file_identity "$temporary_policy_path") || return 1
	test "$current_identity" = "$temporary_policy_identity" || return 1
	case "$current_identity" in
		"$EUID:755:"*) ;;
		*) return 1 ;;
	esac
	current_contents=$(cat "$temporary_policy_path") || return 1
	test "$current_contents" = "$temporary_policy_contents"
}

ensure_temporary_policy() {
	local policy_path="$bin_dir/policy-rc.d"

	if test -e "$policy_path" || test -L "$policy_path"; then
		log 'existing policy-rc.d controls package service policy during dependency installation'
	else
		temporary_policy_marker="OpenSurge installer temporary no-autostart policy $installer_transaction_id"
		temporary_policy_contents=$'#!/bin/sh\n# '"$temporary_policy_marker"$'\nexit 101'
		printf '%s\n' "$temporary_policy_contents" >"$policy_path" || die 'cannot create temporary no-autostart policy'
		chmod 0755 "$policy_path" || die 'cannot protect temporary no-autostart policy'
		temporary_policy_path=$policy_path
		temporary_policy_identity=$(policy_file_identity "$policy_path") || die 'cannot identify temporary no-autostart policy'
		case "$temporary_policy_identity" in
			"$EUID:755:"*) ;;
			*) die 'cannot protect temporary no-autostart policy' ;;
		esac
	fi
}

restore_temporary_policy() {
	if test -z "$temporary_policy_path"; then
		return
	fi
	if temporary_policy_is_ours; then
		rm -f -- "$temporary_policy_path" || die 'cannot remove temporary no-autostart policy'
	else
		log 'retained changed temporary policy-rc.d instead of removing a file no longer owned by the installer'
	fi
	temporary_policy_path=''
	temporary_policy_identity=''
	temporary_policy_contents=''
	temporary_policy_marker=''
}

installer_marker_is_ours() {
	local current_identity
	local current_contents

	test -f "$installer_marker_path" && ! test -L "$installer_marker_path" || return 1
	current_identity=$(policy_file_identity "$installer_marker_path") || return 1
	test "$current_identity" = "$installer_marker_identity" || return 1
	case "$current_identity" in
		"$EUID:600:"*) ;;
		*) return 1 ;;
	esac
	current_contents=$(cat "$installer_marker_path") || return 1
	test "$current_contents" = "$installer_marker_contents"
}

create_installer_marker() {
	local opensurge_run_dir="$run_dir/opensurge"
	local temporary_marker

	test ! -L "$opensurge_run_dir" || die 'OpenSurge runtime directory must not be a symbolic link'
	mkdir -p "$opensurge_run_dir" || die 'cannot create OpenSurge runtime directory'
	installer_marker_dir="$opensurge_run_dir/installer"
	test ! -L "$installer_marker_dir" || die 'installer marker directory must not be a symbolic link'
	mkdir -p "$installer_marker_dir" || die 'cannot create installer marker directory'
	chown root:root "$installer_marker_dir" || die 'cannot set installer marker directory ownership'
	chmod 0700 "$installer_marker_dir" || die 'cannot protect installer marker directory'
	installer_marker_path="$installer_marker_dir/transaction-$installer_transaction_id.marker"
	test ! -e "$installer_marker_path" && ! test -L "$installer_marker_path" || \
		die 'installer transaction marker already exists'
	installer_marker_contents=$'opensurge-installer-marker-v1\ntransaction_id='"$installer_transaction_id"
	temporary_marker=$(mktemp "$installer_marker_dir/.marker.XXXXXX") || die 'cannot create installer transaction marker'
	printf '%s\n' "$installer_marker_contents" >"$temporary_marker" || die 'cannot write installer transaction marker'
	chmod 0600 "$temporary_marker" || die 'cannot protect installer transaction marker'
	chown root:root "$temporary_marker" || die 'cannot set installer transaction marker ownership'
	mv -- "$temporary_marker" "$installer_marker_path" || die 'cannot install transaction marker'
	installer_marker_identity=$(policy_file_identity "$installer_marker_path") || die 'cannot identify installer transaction marker'
	case "$installer_marker_identity" in
		"$EUID:600:"*) ;;
		*) die 'cannot protect installer transaction marker' ;;
	esac
}

restore_installer_marker() {
	if test -z "$installer_marker_path"; then
		return
	fi
	if installer_marker_is_ours; then
		rm -f -- "$installer_marker_path" || die 'cannot remove installer transaction marker'
	else
		log 'retained changed installer marker instead of removing a file no longer owned by the installer'
	fi
	installer_marker_path=''
	installer_marker_identity=''
	installer_marker_contents=''
	if test -n "$installer_marker_dir"; then
		rmdir "$installer_marker_dir" 2>/dev/null || true
	fi
	installer_marker_dir=''
}

bootstrap_transfer_prerequisites() {
	if test -e "$bin_dir/policy-rc.d" || test -L "$bin_dir/policy-rc.d"; then
		log 'existing policy-rc.d controls package service policy during transfer bootstrap'
	fi
	ensure_temporary_policy

	log 'bootstrapping curl and CA certificates before release retrieval'
	apt-get update
	DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends ca-certificates curl
}

ensure_transfer_prerequisites() {
	transfer_prerequisites_available || bootstrap_transfer_prerequisites
}

install_host_dependencies() {
	ensure_temporary_policy
	log 'installing OpenSurge host dependencies with package service autostart suppressed'
	apt-get update
	DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
		adduser ca-certificates curl dnsmasq nftables iproute2 systemd
}

initialize_install_state_paths() {
	install_state_dir="$state_dir/install-state"
	install_manifest_path="$install_state_dir/manifest"
	resolv_conf_backup_path="$install_state_dir/resolv.conf.before"
}

service_is_enabled() {
	local service=$1

	# systemctl uses non-zero status for normal disabled/static states.
	if systemctl is-enabled "$service" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

service_is_active() {
	local service=$1

	if systemctl is-active --quiet "$service" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

first_nonlocal_nameserver() {
	local resolver_path="$etc_dir/resolv.conf"
	local record_type
	local address
	local ignored

	test -r "$resolver_path" || return 1
	while read -r record_type address ignored; do
		if test "$record_type" = nameserver && is_nonlocal_nameserver "$address"; then
			printf '%s' "$address"
			return 0
		fi
	done <"$resolver_path"
	return 1
}

ipv4_default_gateway() {
	local default_route_output
	local gateway

	default_route_output=$(ip -4 route show default) || return 1
	gateway=$(route_field "$default_route_output" via || true)
	is_unicast_ipv4 "$gateway" || return 1
	printf '%s' "$gateway"
}

select_resolver_handoff() {
	local resolver
	local gateway

	resolver=$(first_nonlocal_nameserver || true)
	if test -n "$resolver"; then
		selected_resolver=$resolver
		resolver_selection=nameserver
		return
	fi
	gateway=$(ipv4_default_gateway || true)
	if test -n "$gateway"; then
		selected_resolver=$gateway
		resolver_selection=gateway
		return
	fi
	die 'no non-local resolver or IPv4 default gateway is available'
}

preflight_resolver_handoff() {
	selected_resolver=none
	resolver_selection=none
	if service_is_active systemd-resolved.service; then
		select_resolver_handoff
	fi
}

ensure_install_state_directory() {
	test ! -L "$install_state_dir" || die 'install-state directory must not be a symbolic link'
	mkdir -p "$install_state_dir" || die 'cannot create install-state directory'
	chown root:root "$install_state_dir" || die 'cannot set install-state directory ownership'
	chmod 0700 "$install_state_dir" || die 'cannot protect install-state directory'
}

write_install_manifest() {
	local temporary_manifest

	temporary_manifest=$(mktemp "$install_state_dir/.manifest.XXXXXX") || die 'cannot create install-state manifest'
	chmod 0600 "$temporary_manifest" || die 'cannot protect install-state manifest'
	cat >"$temporary_manifest" <<EOF
state_version=1
installer_version=1
transaction_id=$installer_transaction_id
install_phase=$install_phase
resolver_was_altered=$resolver_was_altered
resolved_was_altered=$resolved_was_altered
resolved_was_enabled=$resolved_was_enabled
resolved_was_active=$resolved_was_active
dnsmasq_was_altered=$dnsmasq_was_altered
dnsmasq_was_enabled=$dnsmasq_was_enabled
dnsmasq_was_active=$dnsmasq_was_active
resolv_conf_backup_exists=$resolv_conf_backup_exists
resolv_conf_kind=$resolv_conf_kind
selected_resolver=$selected_resolver
resolver_selection=$resolver_selection
EOF
	chown root:root "$temporary_manifest" || die 'cannot set install-state manifest ownership'
	mv -f -- "$temporary_manifest" "$install_manifest_path" || die 'cannot install state manifest'
	chmod 0600 "$install_manifest_path" || die 'cannot protect install-state manifest'
}

snapshot_resolv_conf() {
	local resolver_path="$etc_dir/resolv.conf"

	test ! -e "$resolv_conf_backup_path" && ! test -L "$resolv_conf_backup_path" || \
		die 'resolv.conf backup already exists without an installation manifest'
	if test -L "$resolver_path"; then
		resolv_conf_kind=symlink
		resolv_conf_backup_exists=1
		cp -pP "$resolver_path" "$resolv_conf_backup_path" || die 'cannot snapshot symbolic-link resolv.conf'
	elif test -f "$resolver_path"; then
		resolv_conf_kind=regular
		resolv_conf_backup_exists=1
		cp -pP "$resolver_path" "$resolv_conf_backup_path" || die 'cannot snapshot resolv.conf'
	elif test ! -e "$resolver_path"; then
		resolv_conf_kind=absent
		resolv_conf_backup_exists=0
	else
		die 'resolv.conf must be absent, regular, or a symbolic link'
	fi
}

capture_service_state() {
	if service_is_enabled systemd-resolved.service; then
		resolved_was_enabled=1
	else
		resolved_was_enabled=0
	fi
	if service_is_active systemd-resolved.service; then
		resolved_was_active=1
	else
		resolved_was_active=0
	fi
	if service_is_enabled dnsmasq.service; then
		dnsmasq_was_enabled=1
	else
		dnsmasq_was_enabled=0
	fi
	if service_is_active dnsmasq.service; then
		dnsmasq_was_active=1
	else
		dnsmasq_was_active=0
	fi
}

replace_resolv_conf() {
	local resolver_path="$etc_dir/resolv.conf"
	local temporary_resolver

	temporary_resolver=$(mktemp "$etc_dir/.resolv.conf.opensurge.XXXXXX") || die 'cannot create replacement resolv.conf'
	chmod 0644 "$temporary_resolver" || die 'cannot protect replacement resolv.conf'
	printf 'nameserver %s\n' "$selected_resolver" >"$temporary_resolver" || die 'cannot write replacement resolv.conf'
	chown root:root "$temporary_resolver" || die 'cannot set replacement resolv.conf ownership'
	mv -f -- "$temporary_resolver" "$resolver_path" || die 'cannot replace resolv.conf'
}

suppress_generic_dnsmasq() {
	if test "$dnsmasq_was_enabled" -eq 1 || test "$dnsmasq_was_active" -eq 1; then
		dnsmasq_was_altered=1
		write_install_manifest
		systemctl disable --now dnsmasq.service || die 'cannot disable generic dnsmasq service'
	fi
	if service_is_enabled dnsmasq.service || service_is_active dnsmasq.service; then
		die 'generic dnsmasq service remains enabled or active after dependency installation'
	fi
}

begin_host_state_transaction() {
	install_phase=dependencies_installed
	resolver_was_altered=0
	resolved_was_altered=0
	dnsmasq_was_altered=0
	ensure_install_state_directory
	snapshot_resolv_conf
	capture_service_state
	if test "$resolved_was_active" -eq 1 && test "$selected_resolver" = none; then
		select_resolver_handoff
	fi
	write_install_manifest
	host_state_transaction_started=1

	if test "$resolved_was_active" -eq 1; then
		resolved_was_altered=1
		write_install_manifest
		systemctl disable --now systemd-resolved.service || die 'cannot disable systemd-resolved service'
		replace_resolv_conf
		resolver_was_altered=1
	fi
	suppress_generic_dnsmasq
	install_phase=host_owned
	write_install_manifest
}

format_port_53_listener() {
	local protocol=$1
	local line=$2
	local address=unknown
	local process=unknown
	local pid=unknown
	local field
	local -a fields

	read -r -a fields <<<"$line"
	for field in "${fields[@]}"; do
		if [[ $field == *:53 ]]; then
			address=$field
			break
		fi
	done
	if [[ $line =~ users:\(\(\"([^\"]+)\",pid=([0-9]+) ]]; then
		process=${BASH_REMATCH[1]}
		pid=${BASH_REMATCH[2]}
	fi
	printf '%s %s pid=%s process=%s' "$protocol" "$address" "$pid" "$process"
}

port_53_listener_records() {
	local protocol=$1
	local ss_option=$2
	local output
	local line
	local records=''

	if ! output=$(ss -H "$ss_option" 'sport = :53'); then
		die 'cannot inspect port 53 listeners'
	fi
	while IFS= read -r line || test -n "$line"; do
		test -n "$line" || continue
		records+="$(format_port_53_listener "$protocol" "$line")"$'\n'
	done <<<"$output"
	printf '%s' "$records"
}

reject_fresh_port_53_conflicts() {
	local records
	local tcp_records
	local udp_records

	tcp_records=$(port_53_listener_records tcp -ltnp)
	udp_records=$(port_53_listener_records udp -lunp)
	records=$tcp_records
	if test -n "$records" && test -n "$udp_records"; then
		records+=$'\n'
	fi
	records+=$udp_records
	if test -n "$records"; then
		die "port 53 is already used by an unmanaged listener: $records"
	fi
}

manifest_seen=''
manifest_state_version=''
manifest_installer_version=''
manifest_transaction_id=''
manifest_install_phase=''
manifest_resolver_was_altered=''
manifest_resolved_was_altered=''
manifest_resolved_was_enabled=''
manifest_resolved_was_active=''
manifest_dnsmasq_was_altered=''
manifest_dnsmasq_was_enabled=''
manifest_dnsmasq_was_active=''
manifest_resolv_conf_backup_exists=''
manifest_resolv_conf_kind=''
manifest_selected_resolver=''
manifest_resolver_selection=''

record_manifest_field() {
	local key=$1
	local value=$2

	case " $manifest_seen " in
		*" $key "*) return 1 ;;
	esac
	manifest_seen="$manifest_seen $key"
	printf -v "manifest_$key" '%s' "$value"
}

is_manifest_boolean() {
	case "$1" in
		0|1) return 0 ;;
		*) return 1 ;;
	esac
}

load_install_manifest() {
	local line
	local key
	local value

	test -f "$install_manifest_path" && ! test -L "$install_manifest_path" || return 1
	manifest_seen=''
	manifest_state_version=''
	manifest_installer_version=''
	manifest_transaction_id=''
	manifest_install_phase=''
	manifest_resolver_was_altered=''
	manifest_resolved_was_altered=''
	manifest_resolved_was_enabled=''
	manifest_resolved_was_active=''
	manifest_dnsmasq_was_altered=''
	manifest_dnsmasq_was_enabled=''
	manifest_dnsmasq_was_active=''
	manifest_resolv_conf_backup_exists=''
	manifest_resolv_conf_kind=''
	manifest_selected_resolver=''
	manifest_resolver_selection=''
	while IFS= read -r line || test -n "$line"; do
		key=${line%%=*}
		value=${line#*=}
		case "$key" in
			state_version|installer_version|transaction_id|install_phase|resolver_was_altered|resolved_was_altered|resolved_was_enabled|resolved_was_active|dnsmasq_was_altered|dnsmasq_was_enabled|dnsmasq_was_active|resolv_conf_backup_exists|resolv_conf_kind|selected_resolver|resolver_selection)
				record_manifest_field "$key" "$value" || return 1
				;;
			*) return 1 ;;
		esac
	done <"$install_manifest_path"
	test "$manifest_state_version" = 1 && test "$manifest_installer_version" = 1 || return 1
	[[ $manifest_transaction_id =~ ^[[:alnum:]_.-]+$ ]] || return 1
	case "$manifest_install_phase" in
		dependencies_installed|host_owned|package_installed|complete) ;;
		*) return 1 ;;
	esac
	is_manifest_boolean "$manifest_resolver_was_altered" && \
		is_manifest_boolean "$manifest_resolved_was_altered" && \
		is_manifest_boolean "$manifest_resolved_was_enabled" && \
		is_manifest_boolean "$manifest_resolved_was_active" && \
		is_manifest_boolean "$manifest_dnsmasq_was_altered" && \
		is_manifest_boolean "$manifest_dnsmasq_was_enabled" && \
		is_manifest_boolean "$manifest_dnsmasq_was_active" && \
		is_manifest_boolean "$manifest_resolv_conf_backup_exists" || return 1
	case "$manifest_resolv_conf_kind:$manifest_resolv_conf_backup_exists" in
		absent:0) ;;
		regular:1) test -f "$resolv_conf_backup_path" && ! test -L "$resolv_conf_backup_path" || return 1 ;;
		symlink:1) test -L "$resolv_conf_backup_path" || return 1 ;;
		*) return 1 ;;
	esac
	case "$manifest_selected_resolver:$manifest_resolver_selection" in
		none:none) ;;
		*:nameserver|*:gateway) is_nonlocal_nameserver "$manifest_selected_resolver" || return 1 ;;
		*) return 1 ;;
	esac
}

install_state_exists() {
	if test -e "$install_manifest_path" || test -L "$install_manifest_path"; then
		load_install_manifest || die 'existing install-state manifest is invalid; refusing to alter host DNS ownership'
		return 0
	fi
	return 1
}

stop_opensurge_units() {
	systemctl stop opensurge-gateway.socket opensurge-gateway.service opensurge-control.service >/dev/null 2>&1 || true
}

restore_resolv_conf_from_snapshot() {
	local resolver_path="$etc_dir/resolv.conf"

	case "$manifest_resolv_conf_kind" in
		absent)
			rm -f -- "$resolver_path" || return 1
			;;
		regular)
			test -f "$resolv_conf_backup_path" && ! test -L "$resolv_conf_backup_path" || return 1
			rm -f -- "$resolver_path" || return 1
			cp -pP "$resolv_conf_backup_path" "$resolver_path" || return 1
			;;
		symlink)
			test -L "$resolv_conf_backup_path" || return 1
			rm -f -- "$resolver_path" || return 1
			cp -pP "$resolv_conf_backup_path" "$resolver_path" || return 1
			;;
		*) return 1 ;;
	esac
}

restore_service_state() {
	local service=$1
	local was_enabled=$2
	local was_active=$3

	if test "$was_enabled" -eq 1; then
		systemctl enable "$service" || return 1
	else
		systemctl disable "$service" || return 1
	fi
	if test "$was_active" -eq 1; then
		systemctl start "$service" || return 1
	else
		systemctl stop "$service" || return 1
	fi
}

restore_host_state() {
	if test ! -e "$install_manifest_path" && ! test -L "$install_manifest_path"; then
		host_state_transaction_started=0
		return 0
	fi
	load_install_manifest || return 1
	stop_opensurge_units
	if test "$manifest_resolver_was_altered" -eq 1; then
		restore_resolv_conf_from_snapshot || return 1
	fi
	if test "$manifest_resolved_was_altered" -eq 1; then
		restore_service_state systemd-resolved.service "$manifest_resolved_was_enabled" "$manifest_resolved_was_active" || return 1
	fi
	if test "$manifest_dnsmasq_was_altered" -eq 1; then
		restore_service_state dnsmasq.service "$manifest_dnsmasq_was_enabled" "$manifest_dnsmasq_was_active" || return 1
	fi
	rm -f -- "$install_manifest_path" || return 1
	if test "$manifest_resolv_conf_backup_exists" -eq 1; then
		rm -f -- "$resolv_conf_backup_path" || return 1
	fi
	host_state_transaction_started=0
}

rollback_host_state() {
	restore_host_state
}

download_url() {
	local url=$1
	local output=$2
	local effective_url

	if test "$allow_insecure_test_release" -eq 1; then
		effective_url=$(curl --fail --location --proto '=http,https,file' --tlsv1.2 \
			--output "$output" --write-out '%{url_effective}' "$url") || die 'download failed'
	else
		case "$url" in
			https://github.com/three-b0dy/OpenSurge-for-Linux/releases/*) ;;
			*) die 'release downloads must use HTTPS GitHub Release URLs' ;;
		esac
		effective_url=$(curl --fail --location --proto '=https' --tlsv1.2 \
			--output "$output" --write-out '%{url_effective}' "$url") || die 'download failed'
	fi

	test -n "$effective_url" || die 'release redirect did not resolve'
	printf '%s' "$effective_url"
}

release_version_from_tag() {
	local tag=$1
	printf '%s' "${tag#v}"
}

resolve_latest_release_tag() {
	local latest_url="$release_repository_url/releases/latest"
	local effective_url
	local tag_prefix="$release_repository_url/releases/tag/"
	local latest_tag

	effective_url=$(download_url "$latest_url" "$download_dir/latest-release")
	case "$effective_url" in
		"$tag_prefix"*) latest_tag=${effective_url#"$tag_prefix"} ;;
		*) die 'latest release redirect did not resolve to a release tag' ;;
	esac
	if ! [[ $latest_tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$ ]]; then
		die 'latest release redirect returned an invalid tag'
	fi
	printf '%s' "$latest_tag"
}

validate_package_filename() {
	local package=$1
	local architecture=$2
	local expected_filename=${3:-}
	local filename

	filename=$(basename -- "$package")
	if test -n "$expected_filename"; then
		test "$filename" = "$expected_filename" || die 'package filename does not match the requested release asset'
		return
	fi
	[[ $filename =~ ^opensurge_[0-9A-Za-z.+:~_-]+_${architecture}\.deb$ ]] || \
		die 'package filename does not match architecture'
}

select_checksum_line() {
	local checksum_file=$1
	local expected_filename=$2
	local line
	local filename
	local matching_count=0
	local matching_line=''

	while IFS= read -r line || test -n "$line"; do
		if [[ ! $line =~ ^([[:xdigit:]]{64})[[:space:]]+(\*)?([^[:space:][:cntrl:]]+)$ ]]; then
			die 'checksum manifest contains an invalid filename or checksum line'
		fi
		filename=${BASH_REMATCH[3]}
		if test "$filename" = "$expected_filename"; then
			matching_count=$((matching_count + 1))
			matching_line=$line
		fi
	done <"$checksum_file"

	test "$matching_count" -eq 1 || die 'checksum manifest must contain exactly one matching package entry'
	printf '%s' "$matching_line"
}

verify_checksum() {
	local package=$1
	local checksum_file=$2
	local package_directory
	local package_filename
	local checksum_line

	package_directory=$(dirname -- "$package")
	package_filename=$(basename -- "$package")
	checksum_line=$(select_checksum_line "$checksum_file" "$package_filename")
	(
		cd "$package_directory"
		printf '%s\n' "$checksum_line" | sha256sum --check --status -
	) || die 'checksum verification failed'
}

verify_package_architecture() {
	local package=$1
	local architecture=$2
	local package_architecture

	package_architecture=$(dpkg-deb -f "$package" Architecture) || die 'cannot read Debian package architecture'
	test "$package_architecture" = "$architecture" || die 'Debian package architecture does not match host architecture'
}

resolve_release_package() {
	local requested_tag=$1
	local architecture=$2
	local tag=$requested_tag
	local version
	local expected_filename

	ensure_transfer_prerequisites
	prepare_download_dir
	if test -z "$tag"; then
		tag=$(resolve_latest_release_tag)
	fi
	version=$(release_version_from_tag "$tag")
	expected_filename="opensurge_${version}_${architecture}.deb"
	checksum_path="$download_dir/SHA256SUMS"
	package_path="$download_dir/$expected_filename"
	download_url "$release_repository_url/releases/download/$tag/SHA256SUMS" "$checksum_path" >/dev/null
	download_url "$release_repository_url/releases/download/$tag/$expected_filename" "$package_path" >/dev/null
	validate_package_filename "$package_path" "$architecture" "$expected_filename"
}

resolve_offline_package() {
	local requested_deb=$1
	local requested_checksums=$2
	local architecture=$3
	local package_directory

	package_path=$(canonical_regular_file "$requested_deb")
	package_directory=$(dirname -- "$package_path")
	if test -n "$requested_checksums"; then
		checksum_path=$(canonical_regular_file "$requested_checksums")
	else
		checksum_path=$(canonical_regular_file "$package_directory/SHA256SUMS")
	fi
	validate_package_filename "$package_path" "$architecture"
}

main() {
	local version=''
	local deb=''
	local checksums=''
	local mode=same_lan
	local downstream_interface=''
	local upstream_interface=''
	local lan_ip=''
	local lan_cidr=''
	local dhcp_range_start=''
	local dhcp_range_end=''
	local package_source_count=0
	local fresh_config=0
	local fresh_install=1
	local state_already_owned=0
	local installed_product_binary=''

	while test "$#" -gt 0; do
		case "$1" in
			--version)
				version=$(require_option_value "$1" "${2:-}")
				package_source_count=$((package_source_count + 1))
				shift 2
				;;
			--deb)
				deb=$(require_option_value "$1" "${2:-}")
				package_source_count=$((package_source_count + 1))
				shift 2
				;;
			--checksums)
				checksums=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--mode)
				mode=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--downstream-interface)
				downstream_interface=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--upstream-interface)
				upstream_interface=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--lan-ip)
				lan_ip=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--lan-cidr)
				lan_cidr=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--dhcp-range-start)
				dhcp_range_start=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--dhcp-range-end)
				dhcp_range_end=$(require_option_value "$1" "${2:-}")
				shift 2
				;;
			--)
				shift
				test "$#" -eq 0 || die "unexpected positional argument: $1"
				;;
			-*) die "unsupported option: $1" ;;
			*) die "unexpected positional argument: $1" ;;
		esac
	done

	validate_arguments
	configure_paths
	initialize_install_state_paths
	installer_transaction_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
	require_root_and_tty
	if test ! -e "$etc_dir/opensurge/config.yaml" && test ! -L "$etc_dir/opensurge/config.yaml"; then
		fresh_config=1
		collect_fresh_topology
	else
		fresh_install=0
	fi
	installed_product_binary="$installer_root$PRODUCTION_BIN_DIR/opensurge"
	if install_state_exists; then
		state_already_owned=1
		fresh_install=0
	fi
	if test -x "$installed_product_binary"; then
		fresh_install=0
	fi
	local architecture
	local package_path=''
	local checksum_path=''

	architecture=$(determine_architecture)
	if test -n "$deb"; then
		resolve_offline_package "$deb" "$checksums" "$architecture"
	else
		resolve_release_package "$version" "$architecture"
	fi
	verify_package_architecture "$package_path" "$architecture"
	verify_checksum "$package_path" "$checksum_path"
	log "verified release asset $(basename -- "$package_path") for $architecture"
	if test "$state_already_owned" -eq 0; then
		preflight_resolver_handoff
	fi
	install_host_dependencies
	if test "$state_already_owned" -eq 0; then
		begin_host_state_transaction
	elif service_is_enabled dnsmasq.service || service_is_active dnsmasq.service; then
		die 'generic dnsmasq service is enabled or active despite existing OpenSurge ownership state'
	fi
	if test "$fresh_install" -eq 1; then
		reject_fresh_port_53_conflicts
	fi
	restore_temporary_policy
	create_installer_marker
	OPENSURGE_INSTALLER_MARKER="$installer_marker_path" dpkg -i "$package_path"
	restore_installer_marker
	if test "$host_state_transaction_started" -eq 1; then
		install_phase=package_installed
		write_install_manifest
	fi
	if test "$fresh_config" -eq 1; then
		render_fresh_config
	else
		log "preserved existing OpenSurge configuration at $etc_dir/opensurge/config.yaml"
	fi
	initialize_administrator
	start_and_verify_control_plane
	if test "$host_state_transaction_started" -eq 1; then
		install_phase=complete
		write_install_manifest
		host_state_transaction_started=0
	fi
	printf 'OpenSurge is ready at %s. Sign in as admin and change the one-time password in the Web UI.\n' "$control_status_url" >>"$tty_path"
}

trap cleanup EXIT
main "$@"
