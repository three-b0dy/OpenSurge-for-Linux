[Unit]
Description=OpenSurge Linux gateway data plane
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/etc/opensurge /var/lib/opensurge /run/opensurge

[Service]
Type=simple
ExecStart=/usr/lib/opensurge/opensurge-gateway --socket /run/opensurge/gateway.sock --config-root /etc/opensurge
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=90s
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/opensurge /var/lib/opensurge /run/opensurge

[Install]
WantedBy=multi-user.target
