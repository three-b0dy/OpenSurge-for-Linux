#!/bin/sh
set -eu

if ! getent group opensurge >/dev/null 2>&1; then
	addgroup --system opensurge
fi
if ! getent passwd opensurge >/dev/null 2>&1; then
	adduser --system --home /var/lib/opensurge --no-create-home \
		--ingroup opensurge --disabled-login --disabled-password \
		--shell /usr/sbin/nologin opensurge
fi

# Create the directories and repair ownership and modes. The rules live in
# internal/layout so this script and `opensurge-setup reset-permissions` cannot
# drift apart; run the shipped binary directly because /usr/bin/opensurge-setup
# is a symlink that dpkg may not have linked yet at this point.
#
# Ownership is load-bearing, not cosmetic: root writes this state but the
# unprivileged control service reads it, and the gateway runs without CAP_CHOWN,
# so only the directories' setgid bit keeps new files in the opensurge group.
/usr/lib/opensurge/opensurge-setup reset-permissions >/dev/null

if command -v systemctl >/dev/null 2>&1; then
	systemctl daemon-reload || true
fi

exit 0
